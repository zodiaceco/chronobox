    "start": "node --import ./jsx.mjs src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@react-email/components": "1.0.12",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  }
}
