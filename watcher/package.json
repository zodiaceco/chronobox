{
  "name": "chronobox-watcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Alerts for Chronobox: watches the chain and tells the people who follow a Chronobox, in Telegram and by email.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
