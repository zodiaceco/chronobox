# Response headers for hosts that read this file (Netlify, Cloudflare Pages). vercel.json has the same headers for Vercel.
# On another host, set the same headers in its own configuration.
#
# index.html must not be cached, so that an update reaches people on the next
# visit. The files in /assets have their content hash in the name and never change.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
